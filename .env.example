# ==============================================================================
# Swarm Multi-Agent & MCP Runtime Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual keys:
#   cp .env.example .env
# ==============================================================================

# Primary LLM API Key (Groq)
# Setting GROQ_API_KEY will automatically populate all agent-specific keys below
# unless individual overrides are specified.
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# Multi-Provider Cloud Keys (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API Key (for gemini-2.0-flash, gemini-1.5-pro)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (for gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Local Ollama / vLLM / Custom OpenAI-Compatible Endpoints (Optional)
# ------------------------------------------------------------------------------
# Custom endpoint for local LLM routing
# SWARM_LLM_URL=http://localhost:11434/v1/chat/completions

# ------------------------------------------------------------------------------
# Agent-Specific LLM API Key Overrides (Optional)
# ------------------------------------------------------------------------------
# API Key for Domain / Basic Agent with MCP tools (Port 8180)
LLM_A2A_API_KEY=your_groq_api_key_here

# API Key for MCP Runtime Tool Loop (Port 8000)
LLM_MCP_API_KEY=your_groq_api_key_here

# API Key for Planner Agent Orchestrator (Port 8280)
LLM_PLANNER_API_KEY=your_groq_api_key_here

# API Key for Evaluation / Judge Service (Port 7000)
LLM_JUDGE_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# Security & Authentication (Optional)
# ------------------------------------------------------------------------------
# Shared secret for OAuth2 JWT validation in SecureAgentServer
AUTH_JWT_SECRET=your_jwt_secret_key_here

# ------------------------------------------------------------------------------
# Service Endpoints (Defaults)
# ------------------------------------------------------------------------------
DISCOVERY_SERVICE_URL=http://127.0.0.1:4000
MEMORY_SERVICE_URL=http://127.0.0.1:5000
EVALUATION_SERVICE_URL=http://127.0.0.1:7000
